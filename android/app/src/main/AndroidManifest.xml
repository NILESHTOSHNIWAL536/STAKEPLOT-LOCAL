        <activity-alias
            android:name="com.stakeplot.pfa.IconDefault"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/launcher_icon"
            android:label="Stakeplot"
            android:targetActivity="com.stakeplot.pfa.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Other icons (disabled by default) -->
        <activity-alias
            android:name="com.stakeplot.pfa.Icon1"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon1"
            android:label="Stakeplot"
            android:targetActivity="com.stakeplot.pfa.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.stakeplot.pfa.Icon2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon2"
            android:label="Stakeplot"
            android:targetActivity="com.stakeplot.pfa.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.stakeplot.pfa.Icon3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon3"
            android:label="Stakeplot"
            android:targetActivity="com.stakeplot.pfa.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Receivers and widget metadata -->
        <receiver
            android:name="com.stakeplot.pfa.StakeplotWidgetProvider"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/>
        </receiver>

        <receiver
            android:name="com.stakeplot.pfa.ClickableWidget"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/click_info" />
        </receiver>

        <receiver android:name="com.stakeplot.pfa.WidgetClickReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.stakeplot.WIDGET_CLICK" />
                <action android:name="com.stakeplot.WIDGET_CLICKED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.stakeplot.pfa.PayableWidgetProvider"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/payable_widget_info" />
        </receiver>

        <receiver
            android:name="com.stakeplot.pfa.NextFetchWidgetProvider"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_fetch_widget_info"/>
        </receiver>
        <receiver
    android:name="com.stakeplot.pfa.StridesWidgetProvider"
    android:exported="true"
    android:permission="android.permission.BIND_APPWIDGET">

    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
    </intent-filter>

    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/strides_widget_info"/>
</receiver>

        <!-- Flutter embedding meta-data -->
        <meta-data android:name="flutterEmbedding" android:value="2"/>
        <receiver android:name="com.stakeplot.pfa.StakeplotWidgetProvider" android:exported="true" android:enabled="true"
        android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>
        <receiver
        android:name="com.stakeplot.pfa.PayableWidgetProvider" android:exported="true" android:enabled="true"
        android:permission="android.permission.BIND_APPWIDGET">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/payable_widget_info" />
    </receiver>
    </application>
    
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
     <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        </queries>
</manifest>
    