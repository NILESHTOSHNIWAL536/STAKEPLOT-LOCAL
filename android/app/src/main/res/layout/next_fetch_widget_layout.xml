<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_fetch_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Row: Title & Countdown -->
    <ImageView
    android:id="@+id/next_fetch_image"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:scaleType="centerCrop"
    android:adjustViewBounds="true"
    android:layout_marginBottom="8dp"
    android:src="@drawable/countdown"
    android:contentDescription="Widget image" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:weightSum="1">

        <TextView
            android:id="@+id/next_fetch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:text="⏰ Next Fetch"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4B4D73"/>

        <TextView
            android:id="@+id/next_fetch_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="Calculating..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="end"
            android:textColor="#00796B"/>
    </LinearLayout>

    <!-- Status or Info (Optional, e.g., last fetch or status) -->
    <TextView
        android:id="@+id/next_fetch_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to fetch"
        android:textSize="12sp"
        android:textColor="#555555"
        android:gravity="center_horizontal"
        android:layout_marginBottom="6dp"/>

    <!-- Date Range (Centered) -->
    <TextView
        android:id="@+id/next_fetch_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗓️ 11 Nov - 12 Nov"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center_horizontal"/>

</LinearLayout>


