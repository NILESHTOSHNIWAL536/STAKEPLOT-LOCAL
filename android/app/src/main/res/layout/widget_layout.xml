<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Row: Expenses & Total Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:weightSum="1">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="💸 Expenses"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#004856"/>

        <TextView
            android:id="@+id/widget_total_spending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="₹0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="end"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Categories: Two Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:weightSum="2">

        <!-- Left Column: Up to 2 Categories -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_categories_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="None"
                android:textSize="12sp"
                android:textColor="#555555"
                android:typeface="monospace"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- Right Column: Up to 2 Categories -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/widget_categories_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="None"
                android:textSize="12sp"
                android:textColor="#555555"
                android:typeface="monospace"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Date Range (Centered) -->
    <TextView
        android:id="@+id/widget_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗓️ 01 Jan - 01 Jan"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center_horizontal"/>

</LinearLayout>