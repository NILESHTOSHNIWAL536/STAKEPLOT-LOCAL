{
  "compilerOptions": {
    "rootDir": "./src2",
    "baseUrl": "./src2",
    "paths": {
      "@/*": ["*"],
      "@/types/*": ["types/*"]
    },
    "outDir": "./dist",
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "sourceMap": true,
    "typeRoots": [
      "./src2/@types",
      "./node_modules/@types"
    ]
  },
  "include": ["src2/**/*.ts", "src2/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
